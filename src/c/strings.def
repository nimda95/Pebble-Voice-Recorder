// Watch UI text in English, the fallback for every language. Translations are in
// strings_<lang>.def, keyed by the same ids. Text must stay short: the Pebble 2 Duo screen is
// 144 px wide, and the action bar takes 30 of that on the recorder and player.
// Format specifiers (%s, %d, %%) must stay in the same order in every language.

// Recorder
S(S_READY, "Ready")
S(S_RECORDING, "Recording")
S(S_PAUSED, "Paused")
S(S_STARTING, "Starting...")
S(S_SAVED, "Saved")
S(S_DISCARDED, "Discarded")
S(S_SAVING_TO_PHONE, "Saving to phone")
S(S_PHONE_OFFLINE, "Phone offline")
S(S_SAVING_TO_WATCH, "Saving to watch")
S(S_MIC_PAUSED, "Mic paused")
S(S_HEALTH_FMT, "Health: %s")
S(S_SIZE_LEFT_FMT, "%s, %s left")              // "650 KB, 2:36 left"
S(S_FREE_FMT, "%s free")                       // "650 KB free"
S(S_FREE_ON_PHONE_FMT, "%s free on phone")
S(S_LEFT_FMT, "%s left")                       // "2:36 left"
S(S_ERR_START, "Couldn't start recording.")
S(S_ASK_DISCARD, "Discard this recording?")

// Recording health
S(S_H_GOOD, "Good")
S(S_H_SLOW, "Slow storage")
S(S_H_LOW, "Storage low")
S(S_H_DROPPING, "Dropping audio")
S(S_H_PHONE_LAG, "Phone lagging")
S(S_H_PHONE_SILENT, "Phone silent")
S(S_H_CONNECTING, "Connecting...")

// Recorder errors and notices (dialogs)
S(S_ERR_MIC_PERMISSION, "In the Pebble app, turn on \"Plugins / permissions preview\" and allow the microphone.")
S(S_ERR_MIC_BUSY, "The microphone is in use.")
S(S_ERR_NO_MIC, "This watch has no microphone.")
S(S_ERR_REC_MEMORY, "Not enough memory to record.")
S(S_ERR_NOT_FOREGROUND, "Open the app to record.")
S(S_ERR_MIC_START, "Couldn't start the microphone.")
S(S_ERR_MIC_REVOKED, "The microphone permission was turned off.")
S(S_ERR_WATCH_FULL, "Watch storage is full. Delete or move recordings first.")
S(S_ERR_TOO_MANY, "Too many recordings. Delete some first.")
S(S_N_PHONE_FULL_SAVED, "Phone storage is full. Saved.")
S(S_N_LONGEST, "Longest recording reached. Saved.")
S(S_N_WATCH_FULL_SAVED, "Watch storage is full. Saved.")
S(S_N_PHONE_STOPPED, "Phone stopped answering. Recording on the watch.")
S(S_N_PHONE_NOT_CONNECTED, "Phone not connected. Saving on the watch.")
S(S_N_PHONE_FULL_WATCH, "Phone storage is full. Saving on the watch.")
S(S_N_PHONE_REFUSED, "Phone refused the stream. Saving on the watch.")

// Recordings list
S(S_NO_RECORDINGS, "No recordings yet")
S(S_LIST_RECORDING, "Recording...")
S(S_JOB_TRANSCRIBING, "Transcribing")
S(S_JOB_TRANSLATING, "Translating")
S(S_JOB_UPLOADING, "Uploading")
S(S_JOB_SAVING, "Saving to phone")
S(S_PREFIX_PHONE, "Phone, ")                   // subtitle prefix when the audio is only on the phone
S(S_PREFIX_TEXT, "Text, ")                     // ... when only the transcript is left
S(S_STILL_RECORDING, "This recording is still going. Stop it on the recorder first.")
S(S_DIDNT_WORK, "That didn't work.")
S(S_CONNECT_PHONE, "Connect your phone first.")

// Action menu
S(S_A_PLAY, "Play")
S(S_A_TRANSCRIPT, "Transcript")
S(S_A_TRANSLATION, "Translation")
S(S_A_TRANSCRIBE, "Transcribe")
S(S_A_TRANSCRIBE_AGAIN, "Transcribe again")
S(S_A_TRANSLATE, "Translate")
S(S_A_TRANSLATE_AGAIN, "Translate again")
S(S_A_TRANSLATE_EN, "Translate to English")
S(S_A_UPLOAD, "Upload to WebDAV")
S(S_A_UPLOAD_AGAIN, "Upload again")
S(S_A_SAVE, "Save to phone")
S(S_A_DELETE, "Delete")
S(S_A_FROM_WATCH, "From watch")
S(S_A_EVERYWHERE, "Everywhere")
S(S_ASK_DELETE, "Delete this recording?")
S(S_ASK_DELETE_WATCH_KEEP, "Delete from the watch? The phone keeps its copy.")
S(S_ASK_DELETE_AUDIO_KEEP_TEXT, "Delete the audio? The transcript stays on the phone.")
S(S_ASK_DELETE_BOTH, "Delete from the watch and the phone?")

// Playback and transcript
S(S_PLAYING, "Playing")
S(S_LOADING, "Loading")
S(S_LOADING_FROM_PHONE, "Loading from phone")
S(S_FINISHED, "Finished")
S(S_CANT_PLAY, "Can't play")
S(S_OF_FMT, "of %s")                           // "of 1:04", under the position
S(S_SELECT_TO_PLAY_FMT, "%s, Select to play")  // "1:04, Select to play"
S(S_VOLUME_FMT, "Volume %d%%")
S(S_REST_ON_PHONE, "Rest of the text is on the phone")
S(S_NO_SPEAKER, "This watch has no speaker.")
S(S_SPEAKER_MUTED, "The speaker is muted in Settings or by Quiet Time.")
S(S_CANT_PLAY_THIS, "Can't play this recording.")
S(S_TR_LOADING, "Loading transcript...")
S(S_TR_CONNECT, "Connect your phone to read the transcript.")
S(S_TR_EMPTY, "The transcript is empty.")
S(S_TR_NONE, "No transcript for this recording.")
S(S_TR_TIMEOUT, "The phone didn't send the transcript. Try again.")
S(S_TL_LOADING, "Loading translation...")
S(S_TL_CONNECT, "Connect your phone to read the translation.")
S(S_TL_EMPTY, "The translation is empty.")
S(S_TL_NONE, "No translation for this recording.")
S(S_TL_TIMEOUT, "The phone didn't send the translation. Try again.")

// Player errors
S(S_P_BUSY, "The speaker is busy.")
S(S_P_NO_AUDIO, "No audio for this recording.")
S(S_P_CONNECT, "Connect your phone to play this recording.")
S(S_P_MEMORY, "Not enough memory.")
S(S_P_PHONE_FAILED, "The phone couldn't play this recording.")

