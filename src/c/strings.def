S(S_SEC_RECORDING, "Recording")
S(S_SEC_PLAYBACK, "Playback")
S(S_SEC_STORAGE, "Storage")
S(S_SEC_ABOUT, "About")
S(S_QUALITY, "Quality")
S(S_Q_STANDARD, "Standard")
S(S_Q_HIGH, "High")
